# Environment variables for TTS Demo Tool Web Backend
# Copy this to .env and customize

# Application
DEBUG=true
APP_NAME="TTS Demo Tool Web"

# Server
HOST=0.0.0.0
PORT=8000

# TTS Installation
TTS_PATH=C:/TTS
JMETER_COMMAND=C:/TTS/bin/jmeter.bat

# Data paths (relative to backend directory)
DEMO_CATALOG_PATH=../../demo-tool/src/main/resources/data/demos.json
RUNS_DIRECTORY=../../demo-tool/runs
LOGS_DIRECTORY=./logs

# CORS
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# Execution
MAX_CONCURRENT_DEMOS=3
DEMO_TIMEOUT_SECONDS=600

# ORAN Configuration (Phase 1-4)
ORAN_INSTALL_PATH=C:/ORAN
ORAN_CLI_PATH=C:/ORAN/bin/oran-cli.sh
ORAN_RIC_ENDPOINT=http://localhost:8080
ORAN_DU_SIMULATION=true
# ORAN_CATALOGS_PATH=backend/data/oran_catalogs  # Optional, defaults to runs_directory/oran_catalogs
# ORAN_GENERATED_TESTS_PATH=backend/generated_tests  # Optional, defaults to tts_path/generated_tests
# ORAN_HISTORY_PATH=backend/data/oran_history  # Optional, defaults to runs_directory/oran_history
