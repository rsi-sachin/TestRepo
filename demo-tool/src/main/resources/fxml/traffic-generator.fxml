<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Traffic Generator Tab Content
  Phase 2 Implementation - May 13, 2026
-->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tts.demo.controller.TrafficGeneratorController"
            fitToWidth="true" fitToHeight="true">
    
    <VBox spacing="15" styleClass="tab-content">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        
        <!-- Header -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Traffic Generation Engine" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="READY" styleClass="status-info" 
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <ProgressIndicator fx:id="progressIndicator" visible="false" 
                             maxWidth="30" maxHeight="30"/>
        </HBox>
        
        <Separator/>
        
        <!-- Configuration Section -->
        <VBox spacing="15">
            
            <!-- Profile Name -->
            <VBox spacing="5">
                <Label text="Profile Name:" styleClass="subtitle-label"/>
                <TextField fx:id="profileNameField" promptText="e.g., HSS Auth Test - 15% Failure"/>
            </VBox>
            
            <!-- Volume Controls -->
            <TitledPane text="Call Volume Configuration" expanded="true" collapsible="false">
                <VBox spacing="15">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    
                    <!-- Concurrent Calls -->
                    <VBox spacing="5">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Concurrent Calls:" prefWidth="150"/>
                            <Label fx:id="concurrentCallsLabel" text="50" 
                                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label text="threads" style="-fx-text-fill: #7f8c8d;"/>
                        </HBox>
                        <Slider fx:id="concurrentCallsSlider" min="1" max="500" value="50" 
                               majorTickUnit="50" showTickLabels="true" showTickMarks="true"/>
                    </VBox>
                    
                    <!-- Total Calls -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Total Calls:" prefWidth="150"/>
                        <TextField fx:id="totalCallsField" promptText="10000" 
                                  prefWidth="150"/>
                        <Label text="(0 = continuous until stopped)" 
                              style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    </HBox>
                    
                    <GridPane hgap="20" vgap="10">
                        <!-- Ramp-Up Time -->
                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="Ramp-Up Time:" prefWidth="150"/>
                            <Spinner fx:id="rampUpSpinner" prefWidth="100" editable="true"/>
                            <Label text="seconds"/>
                        </HBox>
                        
                        <!-- Duration -->
                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="Test Duration:" prefWidth="120"/>
                            <Spinner fx:id="durationSpinner" prefWidth="100" editable="true"/>
                            <Label text="seconds (0 = until total calls)"/>
                        </HBox>
                    </GridPane>
                </VBox>
            </TitledPane>
            
            <!-- Failure Injection Controls -->
            <TitledPane text="Failure Injection (3GPP Conformance)" expanded="true" collapsible="false">
                <VBox spacing="15">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    
                    <CheckBox fx:id="enableFailureInjectionCheckBox" 
                             text="Enable Failure Injection" 
                             style="-fx-font-weight: bold;"/>
                    
                    <VBox fx:id="failureInjectionPanel" spacing="15">
                        
                        <!-- Failure Rate -->
                        <VBox spacing="5">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Failure Rate:" prefWidth="150"/>
                                <Label fx:id="failureRateLabel" text="15.0%" 
                                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #e74c3c;"/>
                                <Label text="of total calls" style="-fx-text-fill: #7f8c8d;"/>
                            </HBox>
                            <Slider fx:id="failureRateSlider" min="0" max="100" value="15" 
                                   majorTickUnit="10" showTickLabels="true" showTickMarks="true"/>
                        </VBox>
                        
                        <!-- Failure Node -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Affected Network Node:" prefWidth="150"/>
                            <ComboBox fx:id="failureNodeComboBox" prefWidth="200"/>
                            <Label text="(node where failure occurs)" 
                                  style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                        </HBox>
                        
                        <!-- 3GPP Conformance Scenario -->
                        <VBox spacing="5">
                            <Label text="3GPP Conformance Scenario:" styleClass="subtitle-label"/>
                            <ComboBox fx:id="scenarioComboBox" prefWidth="400" maxWidth="Infinity"/>
                            <Label fx:id="scenarioDescriptionLabel" wrapText="true" 
                                  style="-fx-text-fill: #34495e; -fx-font-size: 12px; -fx-padding: 5;"/>
                        </VBox>
                    </VBox>
                </VBox>
            </TitledPane>
            
            <!-- Call Timing Controls -->
            <TitledPane text="Call Timing Parameters" expanded="false">
                <GridPane hgap="20" vgap="15">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    
                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label text="Call Hold Time:" prefWidth="150"/>
                        <Spinner fx:id="callHoldTimeSpinner" prefWidth="100" editable="true"/>
                        <Label text="ms"/>
                    </HBox>
                    
                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <Label text="Inter-Call Delay:" prefWidth="120"/>
                        <Spinner fx:id="interCallDelaySpinner" prefWidth="100" editable="true"/>
                        <Label text="ms"/>
                    </HBox>
                </GridPane>
            </TitledPane>
            
            <!-- Control Buttons -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button fx:id="startButton" text="Start Traffic Generation" 
                       onAction="#handleStart" styleClass="button-success" 
                       prefWidth="180" prefHeight="40" 
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Button fx:id="stopButton" text="Stop" 
                       onAction="#handleStop" styleClass="button-danger" 
                       prefWidth="100" prefHeight="40"/>
                <Button fx:id="exportButton" text="Export Data" 
                       onAction="#handleExport" styleClass="button-secondary" 
                       prefWidth="120"/>
                <Button fx:id="resetButton" text="Reset" 
                       onAction="#handleReset" styleClass="button-secondary" 
                       prefWidth="100"/>
            </HBox>
        </VBox>
        
        <Separator/>
        
        <!-- Live Statistics Section -->
        <VBox spacing="15">
            <Label text="Live Statistics" styleClass="title-label"/>
            
            <!-- Progress Bar -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Progress:" prefWidth="100"/>
                    <ProgressBar fx:id="progressBar" progress="0" prefWidth="400"/>
                    <Label fx:id="progressLabel" text="0%" 
                          style="-fx-font-weight: bold;"/>
                </HBox>
            </VBox>
            
            <!-- Statistics Grid -->
            <GridPane hgap="30" vgap="15" styleClass="stats-grid">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                
                <!-- Row 1 -->
                <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <Label text="Total Attempts" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    <Label fx:id="totalAttemptsLabel" text="0" 
                          style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
                
                <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <Label text="Successful Calls" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    <Label fx:id="successfulCallsLabel" text="0" 
                          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                </VBox>
                
                <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="2">
                    <Label text="Failed Calls" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    <Label fx:id="failedCallsLabel" text="0" 
                          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                </VBox>
                
                <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="3">
                    <Label text="Success Rate" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    <Label fx:id="successRateLabel" text="0.0%" 
                          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                </VBox>
                
                <!-- Row 2 -->
                <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="0">
                    <Label text="Avg Response Time" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    <Label fx:id="avgResponseTimeLabel" text="0 ms" 
                          style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>
                
                <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <Label text="Throughput" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    <Label fx:id="callsPerSecondLabel" text="0.0" 
                          style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label text="calls/second" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                </VBox>
                
                <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.columnSpan="2">
                    <Label text="Elapsed Time" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    <Label fx:id="elapsedTimeLabel" text="00:00:00" 
                          style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                </VBox>
            </GridPane>
            
            <!-- Failure Breakdown -->
            <VBox spacing="10">
                <Label text="Failure Breakdown by Type" styleClass="subtitle-label"/>
                <GridPane fx:id="failureBreakdownGrid" hgap="20" vgap="5" 
                         style="-fx-padding: 10; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-background-color: #ecf0f1;">
                    <Label text="No failures recorded" style="-fx-text-fill: #7f8c8d;" 
                          GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                </GridPane>
            </VBox>
            
            <!-- Throughput Chart -->
            <VBox spacing="10">
                <Label text="Real-Time Node Throughput" styleClass="subtitle-label"/>
                <LineChart fx:id="throughputChart" prefHeight="300" legendVisible="true" animated="false">
                    <xAxis>
                        <NumberAxis fx:id="chartXAxis" label="Time (seconds)" autoRanging="true"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="chartYAxis" label="Messages per Second" autoRanging="true"/>
                    </yAxis>
                </LineChart>
            </VBox>
        </VBox>
        
    </VBox>
</ScrollPane>
