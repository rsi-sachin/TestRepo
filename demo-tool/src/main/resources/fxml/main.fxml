<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tts.demo.controller.MainController"
            stylesheets="@../css/styles.css">
    
    <!-- Top Menu Bar -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Refresh Catalog" onAction="#handleRefreshCatalog"/>
                <SeparatorMenuItem/>
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>
            <Menu text="View">
                <MenuItem text="Show Run History" onAction="#handleShowRunHistory"/>
                <MenuItem text="Clear History" onAction="#handleClearHistory"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#handleAbout"/>
                <MenuItem text="Validate TTS Installation" onAction="#handleValidateTTS"/>
            </Menu>
        </MenuBar>
    </top>
    
    <!-- Main Content -->
    <center>
        <SplitPane dividerPositions="0.35" fx:id="mainSplitPane">
            
            <!-- Left Panel - Demo Catalog -->
            <VBox spacing="10" styleClass="main-container" minWidth="320" prefWidth="400">
                <Label text="TTS Demo Catalog" styleClass="title-label"/>
                
                <!-- Search and Filter -->
                <VBox spacing="10" styleClass="filter-panel">
                    <TextField fx:id="searchField" 
                              promptText="Search demos..." 
                              styleClass="search-box"
                              onKeyReleased="#handleSearch"/>
                    
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="Protocol:"/>
                        <ComboBox fx:id="protocolFilter" 
                                 promptText="All Protocols"
                                 onAction="#handleFilterChange"/>
                        <Label text="Complexity:"/>
                        <ComboBox fx:id="complexityFilter" 
                                 promptText="All Levels"
                                 onAction="#handleFilterChange"/>
                    </HBox>
                    
                    <Button text="Clear Filters" 
                           onAction="#handleClearFilters"
                           styleClass="button-secondary"/>
                </VBox>
                
                <!-- Demo List -->
                <Label fx:id="demoCountLabel" text="0 demos" styleClass="subtitle-label"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox fx:id="demoListContainer" spacing="10">
                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>
            
            <!-- Right Panel - Demo Details and Execution -->
            <VBox spacing="15" styleClass="main-container">
                
                <!-- Demo Details with Tabbed Interface -->
                <VBox fx:id="demoDetailsPane" spacing="10" managed="false" visible="false" VBox.vgrow="ALWAYS">
                    
                    <!-- Demo Title (stays outside tabs) -->
                    <Label fx:id="demoTitleLabel" styleClass="title-label" wrapText="true"/>
                    
                    <HBox spacing="10">
                        <Label fx:id="protocolBadge" styleClass="protocol-badge"/>
                        <Label fx:id="complexityBadge" styleClass="complexity-badge"/>
                    </HBox>
                    
                    <!-- Tabbed Content -->
                    <TabPane fx:id="demoTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                        
                        <!-- Tab 1: Configuration -->
                        <Tab fx:id="configTab" text="Configuration" closable="false">
                            <ScrollPane fitToWidth="true" fitToHeight="true">
                                <VBox spacing="10" styleClass="tab-content">
                                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                    
                                    <VBox spacing="5">
                                        <Label text="Description:" styleClass="subtitle-label"/>
                                        <Label fx:id="demoDescriptionLabel" wrapText="true" styleClass="demo-description"/>
                                    </VBox>
                                    
                                    <VBox spacing="5">
                                        <Label text="Expected Outcome:" styleClass="subtitle-label"/>
                                        <Label fx:id="demoOutcomeLabel" wrapText="true" styleClass="demo-outcome"/>
                                    </VBox>
                                    
                                    <Separator/>
                                    
                                    <!-- Parameters Configuration -->
                                    <Label text="Configuration Parameters:" styleClass="subtitle-label"/>
                                    <ScrollPane maxHeight="200" fitToWidth="true">
                                        <GridPane fx:id="parametersGrid" hgap="10" vgap="10">
                                            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                                        </GridPane>
                                    </ScrollPane>
                                    
                                    <Separator/>
                                    
                                    <!-- Action Buttons -->
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Button fx:id="runButton" 
                                               text="Run Demo" 
                                               onAction="#handleRunDemo"
                                               styleClass="button-success"
                                               prefWidth="120"/>
                                        <Button fx:id="stopButton" 
                                               text="Stop" 
                                               onAction="#handleStopDemo"
                                               styleClass="button-danger"
                                               prefWidth="120"
                                               disable="true"/>
                                        <ProgressIndicator fx:id="progressIndicator" 
                                                          visible="false" 
                                                          maxWidth="30" 
                                                          maxHeight="30"/>
                                        <Label fx:id="statusLabel" styleClass="status-running"/>
                                    </HBox>
                                </VBox>
                            </ScrollPane>
                        </Tab>
                        
                        <!-- Tab 2: Execution -->
                        <Tab fx:id="executionTab" text="Execution" closable="false">
                            <VBox spacing="10" VBox.vgrow="ALWAYS">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                
                                <!-- Execution Controls -->
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Test Execution:" styleClass="subtitle-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="executionTabStopButton" 
                                           text="Stop" 
                                           onAction="#handleStopDemo"
                                           styleClass="button-danger"
                                           prefWidth="120"
                                           disable="true"/>
                                </HBox>
                                
                                <Separator/>
                                
                                <!-- Call Flow Visualization -->
                                <Label text="Call Flow Visualization:" styleClass="subtitle-label"/>
                                
                                <!-- Diagram Controls -->
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <CheckBox fx:id="showTerminalCheckBox" 
                                             text="Show Terminal" 
                                             onAction="#handleToggleTerminal"
                                             selected="false"/>
                                    <Button text="Export Diagram" 
                                           fx:id="exportDiagramButton"
                                           onAction="#handleExportDiagram"
                                           styleClass="button-secondary"
                                           disable="true"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="callFlowStatusLabel" 
                                          text="Call Flow: Not started"
                                          styleClass="status-info"/>
                                </HBox>
                                
                                <!-- Main Visualization Area (Phase 3: Horizontal Split) -->
                                <SplitPane fx:id="visualizationSplitPane" 
                                          orientation="HORIZONTAL" 
                                          dividerPositions="0.6"
                                          VBox.vgrow="ALWAYS">
                                    
                                    <!-- Call Flow Diagram (Left - 60%) -->
                                    <ScrollPane fitToWidth="true" fitToHeight="true">
                                        <StackPane fx:id="diagramContainer" 
                                                  style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 1;"
                                                  prefWidth="600">
                                            <Label text="Call flow diagram will appear here after running a SIP/IMS demo"
                                                  style="-fx-text-fill: #95a5a6; -fx-font-size: 14px;"/>
                                        </StackPane>
                                    </ScrollPane>
                                    
                                    <!-- Terminal Output (Right - 40%, Initially visible) -->
                                    <TitledPane fx:id="terminalPane" 
                                               text="Terminal Output (Advanced)" 
                                               expanded="true"
                                               collapsible="true"
                                               animated="true">
                                        <TextArea fx:id="outputTextArea" 
                                                editable="false" 
                                                wrapText="false"
                                                styleClass="text-area"/>
                                    </TitledPane>
                                    
                                </SplitPane>
                            </VBox>
                        </Tab>
                        
                        <!-- Tab 3: Architecture (Phase 3) -->
                        <Tab fx:id="architectureTab" text="Architecture" closable="false">
                            <ScrollPane fitToWidth="true" fitToHeight="true">
                                <VBox fx:id="architectureContainer" spacing="10" styleClass="tab-content">
                                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                    <Label text="3GPP VoLTE Network Architecture will appear here" 
                                          style="-fx-text-fill: #95a5a6; -fx-font-size: 14px;"/>
                                </VBox>
                            </ScrollPane>
                        </Tab>
                        
                        <!-- Tab 4: Traffic Generator (Phase 2) - Content loaded programmatically -->
                        <Tab fx:id="trafficGeneratorTab" text="Traffic Generator" closable="false">
                            <!-- Content will be loaded by MainController.initializeTrafficGeneratorController() -->
                        </Tab>
                        
                    </TabPane>
                </VBox>
                
                <!-- Placeholder when no demo selected -->
                <VBox fx:id="placeholderPane" 
                     spacing="20" 
                     alignment="CENTER"
                     VBox.vgrow="ALWAYS">
                    <Label text="Select a demo from the catalog to get started" 
                          style="-fx-font-size: 16px; -fx-text-fill: #95a5a6;"/>
                    <Label text="Use the search and filters on the left to find demos" 
                          style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;"/>
                </VBox>
            </VBox>
            
        </SplitPane>
    </center>
    
    <!-- Bottom Status Bar -->
    <bottom>
        <HBox spacing="15" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 1 0 0 0;">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="TTS Demo Tool v1.0.0"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="ttsStatusLabel" text="TTS: Not Validated"/>
            <Label fx:id="historyCountLabel" text="History: 0 runs"/>
        </HBox>
    </bottom>
    
</BorderPane>
